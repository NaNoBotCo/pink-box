{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://wichaa.net/schema/pink-box-node.schema.json",
 "title": "American donut shop node record",
 "description": "One record per node of the trade: a regional style, a donut, something else in the case, a kitchen practice, a shop, a person, an organization, a day, or a word. The trade's own term is the identity. Every field carries provenance (record default + per-field override). Keys beginning with x_ are free extension slots and are never rejected.",
 "type": "object",
 "required": [
  "schema",
  "id",
  "type",
  "names",
  "region",
  "text",
  "sources",
  "provenance",
  "confidence",
  "updated"
 ],
 "additionalProperties": false,
 "patternProperties": {
  "^x_": {}
 },
 "properties": {
  "schema": {
   "type": "integer",
   "const": 1
  },
  "id": {
   "type": "string",
   "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
  },
  "type": {
   "type": "string",
   "enum": [
    "style",
    "donut",
    "dish",
    "kitchen",
    "place",
    "person",
    "org",
    "event",
    "term",
    "art",
    "story"
   ]
  },
  "names": {
   "type": "object",
   "required": [
    "name"
   ],
   "additionalProperties": false,
   "properties": {
    "name": {
     "type": "string",
     "minLength": 1,
     "description": "the term as the tradition uses it"
    },
    "aliases": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "said": {
     "type": "string",
     "description": "how it is said or spelled locally, when that differs from the written name"
    },
    "sort": {
     "type": "string",
     "description": "sort key when the name starts with an article or a first name"
    }
   }
  },
  "etymology": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "root": {
     "type": "string",
     "description": "the etymon or morpheme split, e.g. Taino barbacoa > Spanish barbacoa > English barbecue"
    },
    "first_attested": {
     "type": "string",
     "description": "earliest dated use you can NAME with a source; blank if none"
    },
    "note": {
     "type": "string"
    },
    "tier": {
     "$ref": "#/$defs/tier"
    },
    "source": {
     "type": "string"
    }
   }
  },
  "region": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string"
   },
   "description": "open list, validated against data/vocab/regions.json with a warning"
  },
  "facets": {
   "type": "object",
   "description": "open per-type facets; values are scalars or lists of scalars. Known keys per type are listed in data/vocab/facets.json",
   "additionalProperties": {
    "type": [
     "string",
     "number",
     "boolean",
     "null",
     "array"
    ],
    "items": {
     "type": [
      "string",
      "number"
     ]
    }
   }
  },
  "text": {
   "type": "object",
   "required": [
    "what"
   ],
   "additionalProperties": false,
   "properties": {
    "what": {
     "type": "string",
     "minLength": 1,
     "description": "one plain paragraph: what it is"
    },
    "story": {
     "type": "string",
     "description": "the narrative, told as narrative; source marks inline: *Tradition —* / *Inference —*"
    },
    "how": {
     "type": "string",
     "description": "how it is made, served, eaten, or done"
    },
    "today": {
     "type": "string",
     "description": "present-tense state, dated where possible"
    },
    "notes": {
     "type": "string"
    }
   }
  },
  "kin": {
   "type": "array",
   "description": "what other nodes ARE to this one, said from here. Directional: the other record says its own sentence back.",
   "items": {
    "type": "object",
    "required": [
     "to",
     "as"
    ],
    "additionalProperties": false,
    "properties": {
     "to": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
     },
     "as": {
      "type": "string",
      "minLength": 1
     },
     "rel": {
      "type": "string",
      "enum": [
       "part",
       "whole",
       "origin",
       "descendant",
       "contrast",
       "place",
       "person",
       "event",
       "term",
       "donut",
       "serves",
       "served-at",
       "same-word",
       "kin",
       "org",
       "style",
       "dish",
       "kitchen",
       "art",
       "story",
       "source"
      ]
     }
    }
   }
  },
  "confusable_with": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "tell"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string"
     },
     "tell": {
      "type": "string"
     }
    }
   }
  },
  "geo": {
   "type": [
    "object",
    "null"
   ],
   "additionalProperties": false,
   "required": [
    "lat",
    "lon"
   ],
   "properties": {
    "lat": {
     "type": "number"
    },
    "lon": {
     "type": "number"
    },
    "precision": {
     "type": "string",
     "enum": [
      "exact",
      "street",
      "town",
      "county",
      "region"
     ]
    },
    "source": {
     "type": "string"
    }
   }
  },
  "address": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "street": {
     "type": "string"
    },
    "city": {
     "type": "string"
    },
    "county": {
     "type": "string"
    },
    "state": {
     "type": "string",
     "enum": [
      "AL",
      "AK",
      "AZ",
      "AR",
      "CA",
      "CO",
      "CT",
      "DE",
      "DC",
      "FL",
      "GA",
      "HI",
      "ID",
      "IL",
      "IN",
      "IA",
      "KS",
      "KY",
      "LA",
      "ME",
      "MD",
      "MA",
      "MI",
      "MN",
      "MS",
      "MO",
      "MT",
      "NE",
      "NV",
      "NH",
      "NJ",
      "NM",
      "NY",
      "NC",
      "ND",
      "OH",
      "OK",
      "OR",
      "PA",
      "PR",
      "RI",
      "SC",
      "SD",
      "TN",
      "TX",
      "UT",
      "VT",
      "VA",
      "WA",
      "WV",
      "WI",
      "WY"
     ]
    },
    "postcode": {
     "type": "string"
    }
   }
  },
  "links": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "label",
     "url"
    ],
    "additionalProperties": false,
    "properties": {
     "label": {
      "type": "string"
     },
     "url": {
      "type": "string",
      "pattern": "^https?://"
     }
    }
   }
  },
  "sources": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^s:"
   },
   "description": "ids from data/sources/sources.json only"
  },
  "provenance": {
   "type": "object",
   "required": [
    "default"
   ],
   "additionalProperties": false,
   "properties": {
    "default": {
     "$ref": "#/$defs/prov"
    },
    "fields": {
     "type": "object",
     "additionalProperties": {
      "$ref": "#/$defs/prov"
     },
     "description": "dotted field path -> provenance override, e.g. text.story"
    }
   }
  },
  "images": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "file",
     "source",
     "license"
    ],
    "additionalProperties": false,
    "properties": {
     "file": {
      "type": "string",
      "description": "path relative to data/images/"
     },
     "source": {
      "type": "string",
      "enum": [
       "commons",
       "own",
       "contributed",
       "flickr",
       "loc",
       "diagram",
       "other"
      ]
     },
     "title": {
      "type": "string"
     },
     "url": {
      "type": "string"
     },
     "page_url": {
      "type": "string"
     },
     "license": {
      "type": "string"
     },
     "license_url": {
      "type": "string"
     },
     "author": {
      "type": "string"
     },
     "credit": {
      "type": "string"
     },
     "alt": {
      "type": "string"
     },
     "date": {
      "type": "string"
     },
     "primary": {
      "type": "boolean"
     },
     "sha256": {
      "type": "string"
     },
     "width": {
      "type": "integer"
     },
     "height": {
      "type": "integer"
     }
    }
   }
  },
  "confidence": {
   "type": "string",
   "enum": [
    "high",
    "medium",
    "low"
   ]
  },
  "needs_verification": {
   "type": "boolean"
  },
  "updated": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "tags": {
   "type": "array",
   "description": "Claims about a place that a reader might pick a place by. Every tag names its evidence; ownership and welcome tags are never inferred.",
   "items": {
    "type": "object",
    "required": [
     "tag",
     "source"
    ],
    "additionalProperties": false,
    "properties": {
     "tag": {
      "type": "string",
      "description": "key from data/vocab/tags.json"
     },
     "source": {
      "type": "string",
      "pattern": "^s:"
     },
     "tier": {
      "type": "string",
      "enum": [
       "cited",
       "harvested",
       "field"
      ]
     },
     "note": {
      "type": "string"
     },
     "since": {
      "type": "string"
     },
     "url": {
      "type": "string",
      "pattern": "^https?://"
     }
    }
   }
  },
  "recognitions": {
   "type": "array",
   "description": "Named recognitions by others (an award, a trail, a certification, a documented oral history, a book chapter). Counted, never weighted by this project.",
   "items": {
    "type": "object",
    "required": [
     "by",
     "what",
     "source"
    ],
    "additionalProperties": false,
    "properties": {
     "by": {
      "type": "string",
      "description": "key from data/vocab/recognizers.json"
     },
     "what": {
      "type": "string"
     },
     "year": {
      "type": [
       "integer",
       "string",
       "null"
      ]
     },
     "source": {
      "type": "string",
      "pattern": "^s:"
     },
     "url": {
      "type": "string",
      "pattern": "^https?://"
     },
     "note": {
      "type": "string"
     }
    }
   }
  },
  "recipes": {
   "type": "array",
   "description": "Free-to-use recipes: public-domain cookbooks in full, CC BY-SA texts with attribution, otherwise ingredients only (a list of ingredients is a fact; instructions are not copied).",
   "items": {
    "type": "object",
    "required": [
     "title",
     "source",
     "license"
    ],
    "additionalProperties": false,
    "properties": {
     "title": {
      "type": "string"
     },
     "source": {
      "type": "string",
      "pattern": "^s:"
     },
     "year": {
      "type": [
       "integer",
       "string",
       "null"
      ]
     },
     "url": {
      "type": "string",
      "pattern": "^https?://"
     },
     "license": {
      "type": "string",
      "description": "Public domain / CC BY-SA 3.0 / CC BY 4.0 / ingredients-only"
     },
     "author": {
      "type": "string"
     },
     "book": {
      "type": "string"
     },
     "page": {
      "type": [
       "string",
       "integer"
      ]
     },
     "ingredients": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "text": {
      "type": "string",
      "description": "the recipe text, verbatim, only when the licence allows"
     },
     "yield": {
      "type": "string"
     },
     "note": {
      "type": "string"
     },
     "region": {
      "type": "string"
     }
    }
   }
  },
  "profile": {
   "type": "object",
   "description": "What is in a donut and what it weighs, measured from a published label, a nutrition table or a published recipe. Grams are per piece as published; serving_g says what a piece weighed. Positions are 1-based ingredient order; 0 = absent; null = unknown.",
   "additionalProperties": false,
   "properties": {
    "dough": {
     "type": [
      "string",
      "null"
     ],
     "enum": [
      "yeast",
      "cake",
      "choux",
      "potato",
      "sourdough",
      "other",
      null
     ],
     "description": "what raises it: yeast, chemical leavening (cake), steam (choux), or something else"
    },
    "finish": {
     "type": [
      "string",
      "null"
     ],
     "description": "glazed, sugared, powdered, iced, filled, topped, plain"
    },
    "kind": {
     "type": [
      "string",
      "null"
     ],
     "enum": [
      "chain",
      "usda",
      "recipe",
      "house",
      null
     ],
     "description": "where the numbers come from: a chain's published table, a USDA FoodData record, a published recipe, or a shop's own"
    },
    "leaven": {
     "type": [
      "string",
      "null"
     ],
     "description": "the leavening the source names, verbatim (baker's yeast, baking powder, baking soda, steam)"
    },
    "serving_g": {
     "type": [
      "number",
      "null"
     ],
     "description": "grams per piece as published; a piece is not a fixed weight"
    },
    "kcal": {
     "type": [
      "number",
      "null"
     ],
     "description": "calories per piece"
    },
    "sugar_g": {
     "type": [
      "number",
      "null"
     ],
     "description": "total sugars per piece, grams"
    },
    "fat_g": {
     "type": [
      "number",
      "null"
     ],
     "description": "total fat per piece, grams"
    },
    "sat_fat_g": {
     "type": [
      "number",
      "null"
     ],
     "description": "saturated fat per piece, grams"
    },
    "carb_g": {
     "type": [
      "number",
      "null"
     ],
     "description": "total carbohydrate per piece, grams"
    },
    "sodium_mg": {
     "type": [
      "number",
      "null"
     ],
     "description": "sodium per piece, milligrams"
    },
    "ingredients": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "flour_rank": {
     "type": [
      "integer",
      "null"
     ],
     "description": "1-based position of flour; 0 absent, null unknown"
    },
    "sugar_rank": {
     "type": [
      "integer",
      "null"
     ],
     "description": "1-based position of sugar, dextrose or syrup"
    },
    "fat_rank": {
     "type": [
      "integer",
      "null"
     ],
     "description": "1-based position of shortening, oil, butter or lard"
    },
    "egg_rank": {
     "type": [
      "integer",
      "null"
     ],
     "description": "1-based position of egg"
    },
    "maker": {
     "type": [
      "string",
      "null"
     ],
     "description": "null where nobody publishes it"
    },
    "town": {
     "type": [
      "string",
      "null"
     ],
     "description": "null where nobody publishes it"
    },
    "state": {
     "type": [
      "string",
      "null"
     ],
     "description": "null where nobody publishes it"
    },
    "source": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^s:",
     "description": "null where nobody publishes it"
    },
    "url": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^https?://",
     "description": "null where nobody publishes it"
    },
    "accessed": {
     "type": [
      "string",
      "null"
     ],
     "description": "null where nobody publishes it"
    },
    "note": {
     "type": [
      "string",
      "null"
     ],
     "description": "null where nobody publishes it"
    }
   }
  },
  "sections": {
   "type": "array",
   "description": "Long-form pieces (type story, art): headed sections rendered in order after text.what",
   "items": {
    "type": "object",
    "required": [
     "h",
     "text"
    ],
    "additionalProperties": false,
    "properties": {
     "h": {
      "type": "string"
     },
     "text": {
      "type": "string"
     },
     "images": {
      "type": "array",
      "items": {
       "type": "integer"
      },
      "description": "indices into images[] to show beside this section"
     }
    }
   }
  },
  "quiz": {
   "type": "object",
   "description": "free-form; used by the side-picker for style records",
   "additionalProperties": true
  },
  "hours": {
   "type": "object",
   "description": "When a place is open, as days rather than a timetable. A day in `open` is open; a day in `closed` is closed; a day in neither is NOT KNOWN, which is never the same thing as closed. `text` is how the place itself puts it.",
   "additionalProperties": false,
   "required": [
    "source"
   ],
   "properties": {
    "open": {
     "type": "array",
     "items": {
      "type": "string",
      "enum": [
       "Mo",
       "Tu",
       "We",
       "Th",
       "Fr",
       "Sa",
       "Su"
      ]
     }
    },
    "closed": {
     "type": "array",
     "items": {
      "type": "string",
      "enum": [
       "Mo",
       "Tu",
       "We",
       "Th",
       "Fr",
       "Sa",
       "Su"
      ]
     }
    },
    "text": {
     "type": "string",
     "description": "the hours in the place's own words, e.g. 'Wednesday to Saturday, until it runs out'"
    },
    "sold_out": {
     "type": "boolean",
     "description": "true when the posted closing time yields to the meat running out"
    },
    "seasonal": {
     "type": "string"
    },
    "source": {
     "type": "string",
     "pattern": "^s:"
    },
    "url": {
     "type": "string",
     "pattern": "^https?://"
    },
    "tier": {
     "type": "string",
     "enum": [
      "cited",
      "harvested",
      "field"
     ]
    },
    "checked": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "note": {
     "type": "string"
    }
   }
  }
 },
 "$defs": {
  "tier": {
   "type": "string",
   "enum": [
    "cited",
    "harvested",
    "tradition",
    "inference",
    "field"
   ]
  },
  "prov": {
   "type": "object",
   "required": [
    "tier"
   ],
   "additionalProperties": false,
   "properties": {
    "tier": {
     "$ref": "#/$defs/tier"
    },
    "source": {
     "type": "string"
    },
    "note": {
     "type": "string"
    },
    "fetched_at": {
     "type": "string"
    }
   }
  }
 }
}